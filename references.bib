	month = dec,
	year = {2016},
	keywords = {Entretien, Interview, Méthodologie, Methodology, Objectivité, Objectivity, Qualitative research, Recherche qualitative, Sociologie, Sociology},
	pages = {32--37},
	file = {ScienceDirect Snapshot:files/3676/S1779012316301954.html:text/html},
}

