	shorttitle = {The biodiversity of {Madagascar}},
	url = {https://www.cambridge.org/core/journals/oryx/article/biodiversity-of-madagascar-one-of-the-worlds-hottest-hotspots-on-its-way-out/FDDA3F40E329166E689020CD35B42CEC},
