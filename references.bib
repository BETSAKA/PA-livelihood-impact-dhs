@article{Liu2024,
	title = {A {Practical} {Guide} to {Counterfactual} {Estimators} for {Causal} {Inference} with {Time}‐{Series} {Cross}‐{Sectional} {Data}},
	volume = {68},
	issn = {0092-5853, 1540-5907},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ajps.12723},
	doi = {10.1111/ajps.12723},
	abstract = {Abstract
            
              This paper introduces a simple framework of counterfactual estimation for causal inference with time‐series cross‐sectional data, in which we estimate the average treatment effect on the treated by directly imputing counterfactual outcomes for treated observations. We discuss several novel estimators under this framework, including the fixed effects counterfactual estimator, interactive fixed effects counterfactual estimator and matrix completion estimator. They provide more reliable causal estimates than conventional two‐way fixed effects models when treatment effects are heterogeneous or unobserved time‐varying confounders exist. Moreover, we propose a new dynamic treatment effects plot, along with several diagnostic tests, to help researchers gauge the validity of the identifying assumptions. We illustrate these methods with two political economy examples and develop an open‐source package,
              fect
              , in both
              R
              and
              Stata
              to facilitate implementation.},
	language = {en},
	number = {1},
	urldate = {2024-06-25},
	journal = {American J Political Sci},
	author = {Liu, Licheng and Wang, Ye and Xu, Yiqing},
	month = jan,
	year = {2024},
	pages = {160--176},
	file = {liu et al_2024_a practical guide to counterfactual estimators for causal inference with.pdf:files/2300/liu et al_2024_a practical guide to counterfactual estimators for causal inference with.pdf:application/pdf},
}

