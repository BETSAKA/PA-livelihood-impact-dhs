@article{Teyssier1995,
	title = {L'{Alaotra}, un espace régional convoité. {Quelle} politique de développement rural dans un contexte d'enjeux fonciers exacerbés? ({L}'{Aloatra}, a coveted region. {Which} rural development policy can be followed in a setting of aggravated competition around land ownership)},
	volume = {72},
	copyright = {free},
	shorttitle = {L'{Alaotra}, un espace régional convoité. {Quelle} politique de développement rural dans un contexte d'enjeux fonciers exacerbés?},
	url = {https://www.persee.fr/doc/bagf_0004-5322_1995_num_72_3_1830},
	doi = {10.3406/bagf.1995.1830},
	abstract = {Résumé. - Depuis une soixantaine d'années l'importance de la région du lac Alaotra dans l'économie malgache s'affirme nettement, favorisée par une configuration morpho-pédologique originale et des infrastructures hydro-agricoles intéressant plus de 30 000 hectares. La relative disponibilité foncière, la possibilité de trouver un emploi rémunéré et la rentabilité de la riziculture extensive ont fait du «grenier à riz» de Madagascar une terre d'élection pour les cultivateurs provenant des Hautes Terres et de la Côte Est. Un flux de migrants, croissant et ininterrompu, favorise l'émergence de nouveaux rapports fonciers. La terre devient un enjeu majeur ; la contrôler est une issue salutaire pour de nombreuses exploitations au statut précaire dont l'essor est conditionné par la maîtrise du sol. Le long d'un front pionnier double, étendant l'espace cultivé simultanément vers le marais à l'aval et les collines et bas-fonds de l'amont, de nouvelles concurrences foncières apparaissent au détriment d'une gestion harmonieuse des ressources. Les modes d'appropriation se diversifient, s'individualisent et cherchent dans une tradition disloquée et une administration sclérosée les moyens d'une reconnaissance.},
	language = {fre},
	number = {3},
	urldate = {2024-04-16},
	journal = {Bulletin de l'Association de Géographes Français},
	publisher = {Association de Géographes Français},
	author = {Teyssier, André},
	year = {1995},
	note = {Company: Persée - Portail des revues scientifiques en SHS
Distributor: Persée - Portail des revues scientifiques en SHS
Institution: Persée - Portail des revues scientifiques en SHS
Label: Persée - Portail des revues scientifiques en SHS},
	pages = {234--247},
	file = {PDF:files/9800/Teyssier - 1995 - L'Alaotra, un espace régional convoité. Quelle politique de développement rural dans un contexte d'e.pdf:application/pdf},
}

