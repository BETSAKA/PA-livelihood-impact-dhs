@book{Pomel1998,
	address = {Pessac},
	series = {À la croisée des sciences},
	title = {La déforestation dans le monde tropical},
	copyright = {https://www.openedition.org/12554},
	isbn = {979-10-300-0382-6},
	url = {https://books.openedition.org/pub/1379},
	abstract = {La destruction fortuite ou programmée des forêts tropicales par les coupes industrielles ou paysannes résulte d'une stratégie de conversion brutale de la forêt en espace agricole et de l'utilisation d'une ressource naturelle lucrative. Les espaces concernés deviennent très sensibles aux feux et la biodiversité y est menacée, souvent appauvrie, les sols sont érodés. La déforestation, conduite sur un mode brutal, déstabilise les équilibres climatiques et sociaux de la planète et augmente les risques de conflits. Face à ce pillage, les savoirs paysans et leurs systèmes agro-forestiers peuvent parfois apporter des réponses adaptées. Ce livre constitue un véritable diagnostic sur une catastrophe écologique majeure.},
