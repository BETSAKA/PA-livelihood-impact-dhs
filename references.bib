@book{2003,
	title = {Conservation de la nature et développement: l'intégration impossible?},
	isbn = {978-2-84586-469-6},
	shorttitle = {Conservation de la nature et développement},
	abstract = {La conservation de la nature est aujourd\&\#39;hui placée à un tournant. Les politiques de protection de la nature cherchent depuis trente ans à intégrer des objectifs de développement, mais cette intégration s\&\#39;avère plus difficile que prévue. L\&\#39;histoire de la conservation est déjà longue. Après les premières tentatives de gestion intégrée aux XVIIIe et XIXe siècles, après les politiques étatiques centralisées des parcs nationaux et des réserves naturelles au XXe siècle, elle connaît actuellement un troisième souffle qui lui permet de se placer comme un exemple concret de développement durable. Mais la conservation peine à définir de nouveaux modèles qui puissent répondre à la fois aux besoins de gestion durable des écosystèmes et aux exigences des acteurs concernés. Comment aménager l\&\#39;espace de manière à assurer à la fois l\&\#39;exploitation et la préservation de la nature ? Comment articuler la diversité biologique avec la diversité des pratiques de gestion des milieux ? Comment développer une valorisation des ressources naturelles qui puisse profiter aux plus défavorisés ? Comment, finalement, faire en sorte que la conservation puisse déboucher sur des régulations émancipatrices, davantage que sur des politiques répressives et conservatrices ? De manière inédite en France, cet ouvrage fait le point sur différentes expériences de \&quot; conservation intégrée \&quot; dans une perspective critique et en les replaçant dans l\&\#39;histoire de la protection de la nature. Des exemples concrets sont associés à des analyses plus générales du modèle dominant de conservation intégrée. Pour celui-ci, la marchandisation de la nature et la participation locale sont les fers de lance de l\&\#39;intégration entre conservation et développement. Mais les différentes contributions de l\&\#39;ouvrage montrent que cette double focalisation est à la fois vecteur et frein d\&\#39;une réelle réappropriation sociale. Une nouvelle forme d\&\#39;intégration apparaît dès lors nécessaire, qui puisse articuler le local, le national et le transnational, et donner à la conservation les outils mondiaux de régulations dont elle a besoin pour sortir de sa \&quot; réserve \&quot;.},
	language = {fr},
	publisher = {KARTHALA Editions},
	month = jan,
	year = {2003},
	note = {Google-Books-ID: mVHBAeOSNl0C},
}

