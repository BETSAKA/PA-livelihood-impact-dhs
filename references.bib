@article{holmesExploringRelationshipLocal2013,
	title = {Exploring the {Relationship} {Between} {Local} {Support} and the {Success} of {Protected} {Areas}},
	volume = {11},
	issn = {0972-4923},
	url = {https://journals.lww.com/coas/fulltext/2013/11010/exploring_the_relationship_between_local_support.4.aspx},
	doi = {10.4103/0972-4923.110940},
	abstract = {The idea that the support of local people is essential for the success of protected areas is widespread in conservation, underpinning various conservation paradigms and policies, yet it has rarely been critically examined. This paper explores the circumstances which determine whether or not local opposition to protected areas can cause them to fail. It focuses on the power relations between protected areas and local communities, and how easily they can influence one another. We present a case study from the Dominican Republic, where despite two decades of resentment with protected policies, local people are unable to significantly challenge them because of fears of violence from guards, inability to reach important political arenas, social ties with guards, and the inability to coordinate action. It concludes by arguing that there are often substantial barriers that prevent local people from challenging unpopular conservation policies, and that local support is not necessarily essential for conservation.},
	language = {en-US},
	number = {1},
	urldate = {2026-04-23},
	journal = {Conservation and Society},
	author = {Holmes, George},
	month = mar,
	year = {2013},
	pages = {72},
}

@article{brandEnvironmentalImpactBonds2021,
	title = {Environmental {Impact} {Bonds}: a common framework and looking ahead},
	volume = {1},
	issn = {2634-4505},
	shorttitle = {Environmental {Impact} {Bonds}},
	url = {https://doi.org/10.1088/2634-4505/ac0b2c},
	doi = {10.1088/2634-4505/ac0b2c},
	abstract = {A frequent barrier to addressing some of our world’s most pressing environmental challenges is a lack of funding. Currently, environmental project funding largely comes from philanthropic and public sources, but this does not meet current needs. Increased coordination and collaboration between multiple levels and sectors of government, in addition to private sector funding, can help address the environmental funding challenge. New financial tools and strategies can enable this transition and facilitate uptake of innovative solutions. One such mechanism, the Environmental Impact Bond (EIB), is an emerging financial tool with the potential to transform the environmental funding landscape. However, these financial instruments are not well understood or recognized beyond those actively involved in EIB projects or in the field of conservation finance. As EIBs gain momentum, there is a clear need for a common framework, including definitions and nomenclature, research needs, and outlook for the future. In this paper, we define EIB mechanics, elucidate the difference between EIBs and Green Bonds, and propose a common vocabulary for the field. Drawing on first-hand experience with the few EIBs which have been deployed, we review and assess lessons learned, trends, and paths for the future. Finally, we propose a set of future targets and discuss research goals for the field to unify around. Through this work, we identify a concrete set of research gaps and objectives, providing evidence for EIBs as one important tool in the environmental finance toolbox.},
	language = {en},
	number = {2},
	urldate = {2026-04-24},
	journal = {Environ. Res.: Infrastruct. Sustain.},
	publisher = {IOP Publishing},
	author = {Brand, M W and Quesnel Seipp, K and Saksa, P and Ulibarri, N and Bomblies, A and Mandle, L and Allaire, M and Wing, O and Tobin-de la Puente, J and Parker, E A and Nay, J and Sanders, B F and Rosowsky, D and Lee, J and Johnson, K and Gudino-Elizondo, N and Ajami, N and Wobbrock, N and Adriaens, P and Grant, S B and Wright, S and Gartner, T and Knight, Z and Gibbons, J P},
	month = jul,
	year = {2021},
	pages = {023001},
	file = {IOP Full Text PDF:files/10214/Brand et al. - 2021 - Environmental Impact Bonds a common framework and looking ahead.pdf:application/pdf},
}

