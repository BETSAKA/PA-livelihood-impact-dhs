	keywords = {protected areas, Biodiversity, impact evaluation, conservation policy, payment for environmental services},
	pages = {58--64},
	file = {Full Text PDF:files/4020/Baylis et al. - 2016 - Mainstreaming Impact Evaluation in Nature Conserva.pdf:application/pdf;Snapshot:files/4021/conl.html:text/html},
}

