@phdthesis{Razafintsalama2016,
	type = {thesis},
	title = {Evaluation des impacts des mesures mises en oeuvre durant les 20 ans du plan d'action environnemental malgache en matière de conservation et d'appui au développement des communautés},
	copyright = {Cirad license},
	url = {https://agritrop.cirad.fr/592448/},
	abstract = {A Madagascar, des réformes ont émergé dans les politiques publiques de gestion des ressources naturelles vers les années 90. De 1990 à 2011, la politique environnementale malgache s'est matérialisé au travers le Plan d'action Environnemental (PAE). Ce Plan se base l'exploitation rationnelle des ressources et la préservation des richesses forestières malgaches au profit du développement durable. Dans le cadre de la thèse, le PAE a été analysé comme une stratégie visant à réduire la vulnérabilité des systèmes système socio-écologique (SES) de la Grande île. Dans la perspective de la mise en oeuvre de nouveaux types d'instruments visant la gestion durable des ressources naturelles de Madagascar, il apparaît nécessaire d'évaluer l'impact environnemental, social et économique des mesures initiées dans le cadre des vingt années de mise en oeuvre du PAE. A partir d'une approche territoriale et historique fondée sur l'analyse du SES constitué par le Corridor Ankeniheny- Zahamena (CAZ), Région Alaotra Mangoro et Atsinanana, les effets des différentes actions initiées en matière de conservation (lutte contre l'extension des surfaces de cultures sur brulis et contre l'exploitation illicite des bois précieux) et d'appui au développement des populations riveraines seront comparés. Les principales méthodes adoptées dans la mise en oeuvre de la thèse reposent surtout sur un cadre d'analyse des politiques publiques par le biais d'un diagnostic de vulnérabilité des politiques environnementales et forestières. L'usage de cette méthode a été précédée par le recours à l'approche système socio écologique SES. L'analyse des impacts attendus a été faite au travers l'analyse comparative des outils des politiques publiques. Elle est axée sur la comparaison des résultats obtenus selon les approches de gestion et de conservation développées par les organismes gestionnaires. Les résultats montrent en premier lieu que les mesures développées dans le cadre des politiques publiques en matière de conservation et d'appui au développement n'ont pas eu les effets escomptés en matière de développement durable. Dans ce sens, une atténuation de la déforestation pour l'ensemble du CAZ est observée, soit une diminution de l'extension des tavy. Toutefois, ce résultat est remis en cause à l'échelle locale dans la mesure où l'on a une augmentation de la déforestation dans deux sites sur trois. D'autre part on constate une recrudescence de l'exploitation illicite des bois précieux durant la période. Enfin, les actions menées en faveur de l'amélioration des conditions de vie des paysans n'ont pas eu les effets escomptés. Les impacts des politiques ne sont pas tangibles pour les populations riveraines des forêts. Cependant, des incohérences au niveau des données ont été observées (variables selon les sources). Les réformes menées n'ont pas favorisé l'utilisation et la valorisation durable des ressources forestières. La vulnérabilité du SES est principalement d'ordre social et économique. Mais il y a aussi d'autres facteurs d'ordre politique et institutionnel. Le SES est aussi vulnérable à son environnement externe qui exerce nombre effets négatifs. Cet environnement est constitué par les paramètres physiques (variabilités climatiques) et politiques. Des contraintes internes existent aussi au sein du SES. Ces obstacles et ces facteurs limitants entravent le processus de mise en oeuvre des politiques en matière de conservation et d'appui au développement à Madagascar. Ces facteurs limitants reposent principalement sur l'incompréhension des fondements des pratiques de tavy et de l'importance des ressources forestières, qui n'ont pas (ou peu) été considérés.},
	language = {fre},
	urldate = {2025-11-20},
	school = {Université d'Antananarivo},
	author = {Razafintsalama, Manitra Harison},
	year = {2016},
	file = {Snapshot:files/9698/592448.html:text/html},
}

