@book{Mermet2005,
	title = {Étudier des écologies futures: un chantier ouvert pour les recherches prospectives environnementales},
	isbn = {978-90-5201-277-3},
	shorttitle = {Étudier des écologies futures},
	abstract = {Gérer des écosystèmes, traiter des problèmes environnementaux, c'est intervenir sur des processus naturels, sociaux, techniques, économiques complexes, qui se déploient sur des décennies. L'étude des dynamiques et des états futurs possibles des systèmes écologiques (y compris dans leurs dimensions sociales) est un domaine de recherche en pleine émergence. Son importance est capitale, aussi bien pour comprendre les systèmes socio-écologiques que pour agir en faveur de l'environnement et du développement durable. De nombreuses disciplines sont concernées, en sciences de la nature, de l'univers, de l'homme et de la société. Chacune devra innover; il leur faudra aussi inventer ensemble des opérations de connaissance adaptées. Ce livre propose des lignes directrices pour organiser le chantier de manière «ouverte». Il montre les défis spécifiques que l'étude d'écologies futures pose à la recherche; il incite à une collaboration entre les chercheurs du champ de l'environnement et les spécialistes de la prospective; il réexamine les grands types de méthodes mobilisables (scénarios, modèles, approches participatives); enfin, le propos est illustré par des études de cas inédites.},
	language = {fr},
	publisher = {Peter Lang},
	author = {Mermet, Laurent},
	year = {2005},
	note = {Google-Books-ID: nn1xKUjD\_dYC},
	keywords = {Nature / Environmental Conservation \& Protection, Science / Environmental Science, Nature / Natural Resources, Political Science / Public Policy / Environmental Policy, Science / Applied Sciences, Science / General, Science / History, Science / Life Sciences / Ecology},
}

@article{Hoeblich1997,
	title = {le plan d’action environnemental ({PAE}) à {Madagascar} : exemple de gestion de l’environnement dans un pays en voie de développement},
	volume = {15},
	copyright = {free},
	shorttitle = {le plan d’action environnemental ({PAE}) à {Madagascar}},
	url = {https://www.persee.fr/doc/etrop_1147-3991_1997_act_15_6_996},
	abstract = {La dégradation générale du milieu naturel et de la qualité de la vie à Madagascar s’est accélérée au cours des vingt dernières années ; cela a suscité une prise de conscience au niveau du pays, relayée par une incitation à l’action de la part de la Banque Mondiale et du Fonds Monétaire International, qui ont fait inscrire dans tout nouveau projet un volet portant sur l’environnement. Ainsi, a été mis en place le Plan d’ Action Environnement (PAE) qui comprend quatre objectifs principaux pour «protéger et améliorer l’ environnement tout en œuvrant pour un développement durable» : — conserver et gérer le patrimoine de la diversité biologique : la biodiversité ; — promouvoir le développement durable par une meilleure gestion des ressources naturelles ; — améliorer les conditions de vie dans les zones rurales et urbaines ; — développer les ressources humaines et la capacité institutionnelle. Pour pouvoir atteindre ces objectifs, la stratégie suivante est en principe appliquée : - une approche intégrée des problèmes et l’application de leurs solutions ; - une vision à long terme avec la continuité de l’appui international fourni à Madagascar ; - pour faire passer les informations et les ordres, l’accent est davantage mis sur la communication et le dialogue, que sur la transmission hiérarchique ; - la présentation des programmes du PAE aux collectivités locales doit se faire sous l’angle des bénéfices plutôt que sous celui des contraintes ; - la participation des populations locales doit être effective dans les projets relevant de l’environnement ; - les ONG et d’autres entreprises du secteur privé peuvent intervenir. Ce projet ambitieux, mis en place en 1991, qui a démarré avec un retard lié aux difficultés politiques de 1991 et 1992, doit se dérouler en principe sur quinze ans ; le coût est estimé à 85,5 millions US \$. Le Programme Environnemental N°1 (PE1) d’une durée de cinq ans montre les difficultés d’une gestion globale avec peu de moyens et des interventions disparates, ce qui a été mis en évidence par l’examen à mi-parcours en novembre 1993. Beaucoup d’actions restent trop ponctuelles et de qualité inégale. La recherche environnementale n’avance que tirés timidement, malgré des compétences locales et internationales reconnues. Toutefois, en dépit de la faiblesse des moyens et du manque de coordination manifeste, la prise de conscience des problèmes environnementaux dans le pays est bien réelle. Si, à Madagascar, on peut s’attendre à peu d’effets immédiats sur l’arrêt de la dégradation de l’environnement, — au mieux, un ralentissement — à l’exception de quelques exemples ponctuels, une tentative de gestion globale du milieu est intéressante à suivre et montre l’importance des enjeux souvent contradictoires.},
	language = {fre},
	number = {6},
	urldate = {2024-11-14},
	journal = {Espaces tropicaux},
	publisher = {Persée - Portail des revues scientifiques en SHS},
	author = {Hoeblich, Jean-marc},
	year = {1997},
	pages = {351--358},
}

