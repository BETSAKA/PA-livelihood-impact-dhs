@article{Estrada2022,
	title = {Global importance of {Indigenous} {Peoples}, their lands, and knowledge systems for saving the world’s primates from extinction},
	volume = {8},
	issn = {2375-2548},
	url = {https://www.science.org/doi/10.1126/sciadv.abn2927},
	doi = {10.1126/sciadv.abn2927},
	abstract = {Primates, represented by 521 species, are distributed across 91 countries primarily in the Neotropic, Afrotropic, and Indo-Malayan realms. Primates inhabit a wide range of habitats and play critical roles in sustaining healthy ecosystems that benefit human and nonhuman communities. Approximately 68\% of primate species are threatened with extinction because of global pressures to convert their habitats for agricultural production and the extraction of natural resources. Here, we review the scientific literature and conduct a spatial analysis to assess the significance of Indigenous Peoples’ lands in safeguarding primate biodiversity. We found that Indigenous Peoples’ lands account for 30\% of the primate range, and 71\% of primate species inhabit these lands. As their range on these lands increases, primate species are less likely to be classified as threatened or have declining populations. Safeguarding Indigenous Peoples’ lands, languages, and cultures represents our greatest chance to prevent the extinction of the world’s primates.
          , 
            Supporting Indigenous Peoples’ land rights is an effective solution to protect the world’s primates from extinction.},
	language = {en},
	number = {32},
	urldate = {2024-10-25},
	journal = {Sci. Adv.},
	author = {Estrada, Alejandro and Garber, Paul A. and Gouveia, Sidney and Fernández-Llamazares, Álvaro and Ascensão, Fernando and Fuentes, Agustin and Garnett, Stephen T. and Shaffer, Christopher and Bicca-Marques, Júlio and Fa, Julia E. and Hockings, Kimberley and Shanee, Sam and Johnson, Steig and Shepard, Glenn H. and Shanee, Noga and Golden, Christopher D. and Cárdenas-Navarrete, Anaid and Levey, Dallas R. and Boonratana, Ramesh and Dobrovolski, Ricardo and Chaudhary, Abhishek and Ratsimbazafy, Jonah and Supriatna, Jatna and Kone, Inza and Volampeno, Sylviane},
	month = aug,
	year = {2022},
	pages = {eabn2927},
	file = {estrada et al_2022_global importance of indigenous peoples, their lands, and knowledge systems for.pdf:files/4182/estrada et al_2022_global importance of indigenous peoples, their lands, and knowledge systems for.pdf:application/pdf},
}

@article{Harris2014,
	title = {Updated high‐resolution grids of monthly climatic observations – the {\textless}span style="font-variant:small-caps;"{\textgreater}{CRU} {TS3}{\textless}/span{\textgreater} .10 {Dataset}},
	volume = {34},
	issn = {0899-8418, 1097-0088},
	shorttitle = {Updated high‐resolution grids of monthly climatic observations – the {\textless}span style="font-variant},
	url = {https://rmets.onlinelibrary.wiley.com/doi/10.1002/joc.3711},
	doi = {10.1002/joc.3711},
	abstract = {ABSTRACT
            
              This paper describes the construction of an updated gridded climate dataset (referred to as
              CRU TS3
              .10) from monthly observations at meteorological stations across the world's land areas. Station anomalies (from 1961 to 1990 means) were interpolated into 0.5° latitude/longitude grid cells covering the global land surface (excluding Antarctica), and combined with an existing climatology to obtain absolute monthly values. The dataset includes six mostly independent climate variables (mean temperature, diurnal temperature range, precipitation, wet‐day frequency, vapour pressure and cloud cover). Maximum and minimum temperatures have been arithmetically derived from these. Secondary variables (frost day frequency and potential evapotranspiration) have been estimated from the six primary variables using well‐known formulae. Time series for hemispheric averages and 20 large sub‐continental scale regions were calculated (for mean, maximum and minimum temperature and precipitation totals) and compared to a number of similar gridded products. The new dataset compares very favourably, with the major deviations mostly in regions and/or time periods with sparser observational data.
              CRU TS3
              .10 includes diagnostics associated with each interpolated value that indicates the number of stations used in the interpolation, allowing determination of the reliability of values in an objective way. This gridded product will be publicly available, including the input station series (
              http://www.cru.uea.ac.uk/
              and
              http://badc.nerc.ac.uk/data/cru/
              ). © 2013 Royal Meteorological Society},
	language = {en},
	number = {3},
	urldate = {2024-10-27},
	journal = {Intl Journal of Climatology},
	author = {Harris, I. and Jones, P.D. and Osborn, T.J. and Lister, D.H.},
	month = mar,
	year = {2014},
	pages = {623--642},
	file = {Harris et al. - 2014 - Updated high‐resolution grids of monthly climatic .pdf:files/4187/Harris et al. - 2014 - Updated high‐resolution grids of monthly climatic .pdf:application/pdf},
}

