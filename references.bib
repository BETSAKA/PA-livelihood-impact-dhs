@book{Agrawal2001,
	title = {Communities and the {Environment}: {Ethnicity}, {Gender}, and the {State} in {Community}-based {Conservation}},
	isbn = {978-0-8135-2914-1},
	shorttitle = {Communities and the {Environment}},
	abstract = {For years environmentalists thought natural resources could be best protected by national legislation. But the poor outcomes of this top-down policy have led conservation professionals today to regard local communities as the agents of conservation efforts. According to a recent survey, more than fifty countries report that they pursue partnerships with local communities in an effort to protect their forests. Despite the recent popularity of a community-based approach, the concept of community rarely receives the attention it should get from those concerned with resource management. This balanced volume redresses the situation, demonstrating both the promise and the potential dangers of community action.  Although the contributors advocate community-based conservation, they examine the record with a critical eye. They pay attention to the concrete political contexts in which communities emerge and operate. Understanding the nature of community requires understanding the internal politics of local regions and their relationship to external forces and actors. Especially critical are issues related to ethnicity, gender, and the state.},
	language = {en},
	publisher = {Rutgers University Press},
	author = {Agrawal, Arun and Gibson, Clark C.},
	year = {2001},
	note = {Google-Books-ID: Ko2nxV9TW84C},
	keywords = {Nature / Environmental Conservation \& Protection, Political Science / General, Nature / Ecology, Social Science / Sociology / General},
}

@phdthesis{Chartier2002,
	type = {phdthesis},
	title = {Le rôle de {Greenpeace} et du {WWF} dans la résolution des problèmes environnementaux. {Quel} espace politique pour quelles {ONG} ?},
	url = {https://hal.science/tel-04985002},
	abstract = {Cette thèse analyse le rôle effectif de deux ONG internationales d’environnement (Greenpeace et le WWF) dans les régulations société/biosphère au début du XXIe siècle. La première partie propose un cadre d’analyse pour étudier ces organisations. Après avoir montré que le terme ONG recouvre diverses réalités qui interdisent les typologies et les définitions normatives-juridiques, deux courants historiques consubstantiels à ces organisations sont identifiés : la charité chrétienne et le libéralisme politique. L’espace politique qu’elles occupent est ensuite défini et renommé (écotone civil) afin d’écarter les malentendus qui règnent autour de la notion de société civile. À l’issue de ces développements, il est proposé une méthode d’analyse identifiant les spécificités diachroniques, spatiales, culturelles, politiques, structurelles et fonctionnelles nécessaires à l’évaluation de chaque ONG étudiée et permettant de comprendre leurs stratégies et leurs logiques d’acteurs. En prenant appui sur cette méthode, les deux parties suivantes analysent dans le détail le WWF et Greenpeace. Il est démontré que malgré des postures différentes vis-à-vis des organisations des sphères publique et marchande, ces deux ONG n’échappent pas aux logiques économiques et sociales dominantes. Elles sont en effet construites comme de véritables entreprises de protestation, le besoin même de pérennité et de légitimité politique les obligeant à rassembler des moyens (argent, donateurs et militants, experts, accès aux médias) qu’il s’agit d’investir de façon rationnelle en vue d’aboutir aux résultats escomptés. À partir des contradictions mises à jour, cette thèse montre en définitive que ces deux ONG participent plus d’une modernisation écologique des dynamiques économiques et sociales contemporaines que d’une résolution des causes des problèmes environnementaux. Au final, ceci remet en question le postulat couramment admis qui fait de ces ONG les acteurs attendus capables de répondre aux changements planétaires face auxquels les gouvernements semblent aujourd’hui si démunis.},
	language = {fr},
	urldate = {2025-05-19},
	school = {Université d'Orléans},
	author = {Chartier, Denis},
	month = may,
	year = {2002},
	file = {Full Text PDF:files/8462/Chartier - 2002 - Le rôle de Greenpeace et du WWF dans la résolution.pdf:application/pdf},
}

