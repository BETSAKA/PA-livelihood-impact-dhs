@article{Adams2007,
	title = {People, {Parks} and {Poverty}: {Political} {Ecology} and {Biodiversity} {Conservation}},
	volume = {5},
	issn = {0972-4923},
	shorttitle = {People, {Parks} and {Poverty}},
	url = {https://journals.lww.com/coas/fulltext/2007/05020/People,_Parks_and_Poverty__Political_Ecology_and.1.aspx},
	abstract = {L'action visant à préserver la biodiversité, en particulier par la création de zones protégées (AP), est intrinsèquement politique. L'écologie politique est un domaine d'étude qui englobe les interactions entre la façon dont la nature est comprise et la politique et les impacts de l'action environnementale. Le présent document examine l'écologie politique de la conservation, en particulier la création d'AP. Il examine les implications de l'idée de nature vierge, les impacts sociaux et la politique de l'Autorité palestinienne et la manière dont les avantages et les coûts des AP sont répartis. Il examine trois questions politiques essentielles dans la politique internationale de conservation contemporaine: les droits des populations autochtones, la relation entre la conservation de la biodiversité et la réduction de la pauvreté, et les arguments de ceux qui préconisent un retour aux AP classiques qui excluent les personnes.},
	language = {fr},
