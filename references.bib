@article{Hufty,
	title = {Proposition de mise en oeuvre du concept de gouvernance: le cadre analytique de la gouvernance},
	shorttitle = {Proposition de mise en oeuvre du concept de gouvernance},
	abstract = {Résumé La présente communication présente le Cadre analytique de la gouvernance (GAF Governance analytical framework). Il s'agit d'une méthodologie pragmatique visant à démontrer le potentiel du concept de gouvernance relatif à l'analyse des enjeux collectifs. L'un des postulats principaux du GAF est le suivant : des processus de gouvernance existent dans toute société et peuvent être observés et analysés à partir d'une perspective non normative et non prescriptive. Contrairement à de nombreuses approches basées sur des solutions ex ante (la solution précède le travail de recherche), nous suggérons que la gouvernance peut devenir un outil destiné à diagnostiquer les processus collectifs qui déterminent la manière dont les décisions sont prises et dont les normes sociales sont élaborées dans le domaine des affaires publiques. Le GAF propose un système de cinq outils analytiques principaux. Ces outils constituent une méthodologie cohérente et articulée de manière logique.},
	author = {Hufty, Marc},
	file = {Hufty - Proposition de mise en oeuvre du concept de gouver.pdf:files/4646/Hufty - Proposition de mise en oeuvre du concept de gouver.pdf:application/pdf},
}

