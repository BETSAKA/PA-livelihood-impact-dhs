@article{Demoncy2016,
	title = {La recherche qualitative : introduction à la méthodologie de l’entretien},
	volume = {16},
	issn = {1779-0123},
	shorttitle = {La recherche qualitative},
	url = {https://www.sciencedirect.com/science/article/pii/S1779012316301954},
	doi = {10.1016/j.kine.2016.07.004},
	abstract = {Résumé
La volonté de créer une science à part entière se manifeste notamment par la construction de la démarche de recherche. Les sciences humaines, par leur objet de recherche spécifique, ont dû se doter d’outils méthodologiques spécifiques. Nous retrouvons cette démarche en kinésithérapie. Pour ce nouveau champ qui s’ouvre aux kinésithérapeutes, la démarche qualitative peut être un outil pertinent pour étudier les représentations et les pratiques sociales des acteurs du monde de la santé. Pour appliquer cette méthode de recherche, le chercheur doit identifier et maîtriser les différentes étapes. Cet article a pour objectif d’introduire la rigueur méthodologique qu’impose l’entretien dans sa réalisation.
Niveau de preuve
Non adapté.
Summary
Setting up a fully-fledged science particular involves developing research practice. Given the specificity of their research, the social sciences have had to acquire specific methodological tools. This can be seen in the discipline of physiotherapy. In this new field opening up for physiotherapists, the qualitative approach may be a useful tool for studying representations and social practices in health-care. In order to put this research methodology into practice, researchers must identify and understand the various steps involved. This article aims to introduce the methodological rigor required for conducting the patient interview.
Level of evidence
Non-applicable.},
