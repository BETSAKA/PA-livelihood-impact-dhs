@article{Schleicher2019,
	title = {Conservation performance of tropical protected areas: {How} important is management?},
	volume = {12},
	issn = {1755-263X, 1755-263X},
	shorttitle = {Conservation performance of tropical protected areas},
	url = {https://conbio.onlinelibrary.wiley.com/doi/10.1111/conl.12650},
	doi = {10.1111/conl.12650},
	abstract = {Abstract
            Increasing the coverage of effectively managed protected areas (PAs) is a key focus of the 2020 Aichi biodiversity targets. PA management has received considerable attention, often based on the widely held, but rarely examined, assumption that positive conservation outcomes will result from increased PA management inputs. To shed light on this assumption, we integrated data on PA management factors with 2006–2011 avoided forest degradation and deforestation across the Peruvian Amazon, using a counterfactual approach, combined with interviews and ranking exercises. We show that while increasing PA management input to Amazonian PAs tended to reduce likelihoods of forest degradation and deforestation, the associations were weak. Key challenges facing PAs ranked by PA managers included wider law enforcement, corruption and land title issues, rather than local management factors. We therefore encourage the post‐2020 conservation targets to adopt holistic approaches beyond PA management, incorporating political, institutional and governance contexts across scales.},
	language = {en},
	number = {5},
	urldate = {2023-10-12},
	journal = {CONSERVATION LETTERS},
	author = {Schleicher, Judith and Peres, Carlos A. and Leader‐Williams, Nigel},
	month = sep,
	year = {2019},
	pages = {e12650},
	file = {Schleicher et al_2019_Conservation performance of tropical protected areas.pdf:files/372/Schleicher et al_2019_Conservation performance of tropical protected areas.pdf:application/pdf},
}

@article{Pyhala2019,
	title = {Managers' perceptions of protected area outcomes in {Madagascar} highlight the need for species monitoring and knowledge transfer},
	volume = {1},
	issn = {2578-4854, 2578-4854},
	url = {https://conbio.onlinelibrary.wiley.com/doi/10.1111/csp2.6},
	doi = {10.1111/csp2.6},
	abstract = {Considerable effort has gone into assessing the effectiveness of protected areas (PAs) in preventing biodiversity loss, and PA impacts on local communities. However, little is known about how pressures are being perceived and dealt with by local PA managers and what perceptions managers have of biodiversity trends and human‐induced pressures in the PAs they manage. We surveyed and convened a workshop with PA managers in Madagascar asking about the impacts of PA establishment. The managers reported that PAs have been successful in reducing threats. However, managers lacked specific knowledge of trends in species abundance, reporting the need for more species monitoring and knowledge transfer from scientific researchers. We argue that greater collaboration and exchange of knowledge between researchers, managers, and local communities is necessary to ensure that PA effectiveness research is of practical value and contributes to improved PA outcomes.},
	language = {en},
	number = {2},
	urldate = {2023-10-12},
	journal = {Conservat Sci and Prac},
	author = {Pyhälä, Aili and Eklund, Johanna and McBride, Marissa F. and Rakotoarijaona, Mamy A. and Cabeza, Mar},
	month = feb,
	year = {2019},
	pages = {e6},
}

@article{Eklund2017,
	title = {Quality of governance and effectiveness of protected areas: crucial concepts for conservation planning},
	volume = {1399},
	issn = {0077-8923, 1749-6632},
	shorttitle = {Quality of governance and effectiveness of protected areas},
	url = {https://nyaspubs.onlinelibrary.wiley.com/doi/10.1111/nyas.13284},
	doi = {10.1111/nyas.13284},
	abstract = {Protected areas (PAs) are a key tool for biodiversity conservation and play a central role in the Convention on Biological Diversity. Recently, the effectiveness of PAs has been questioned, and assessing how effective they are in enabling the future persistence of biodiversity is not trivial. Here, we focus on terrestrial PAs and clarify the terminology related to PA effectiveness, distinguishing between management and ecological aspects. We suggest that the quality of governance affects both aspects of effectiveness but recognize a lack of synthetic understanding of the topic. We present a conceptual framework linking the underlying mechanisms by which the quality of governance affects conservation outcomes in PAs and how this relates to conservation planning. We show that it is crucial to separate pressure and response and how these together will lead to the observed conservation outcomes. We urge for more focused attention on governance factors and in particular more empirical research on how to address causality and how to account for the quality of governance when prioritizing actions. Our framework is linked to the classic concepts of systematic conservation planning and clarifies the strategies available to achieve a comprehensive and effective network of PAs.},
	language = {en},
	number = {1},
	urldate = {2023-10-12},
	journal = {Annals of the New York Academy of Sciences},
	author = {Eklund, Johanna and Cabeza, Mar},
	month = jul,
	year = {2017},
	pages = {27--41},
	file = {Eklund_Cabeza_2017_Quality of governance and effectiveness of protected areas.pdf:files/373/Eklund_Cabeza_2017_Quality of governance and effectiveness of protected areas.pdf:application/pdf},
}

