@book{Vanessa2007,
	title = {Jeux de gouvernance. {Regards} et réflexions sur un concept},
	isbn = {978-2-8111-4236-0},
	abstract = {La \&quot;gouvernance\&quot; est devenue un mot clé de la réflexion sur les sociétés. Cet ouvrage s\&\#39;inscrit au sein des débats autour de ce concept, avec l\&\#39;intention de contribuer à en préciser le sens, tout en illustrant les difficultés liées à son utilisation dans le domaine des relations internationales et du développement. Au-delà de ses utilisations comme outil idéologique ou des effets de mode, le concept apparaît potentiellement utile et novateur. Il n\&\#39;est bien entendu pas question de surestimer ce potentiel : c\&\#39;est pourquoi le regard posé ici est aussi critique.},
	language = {fr},
