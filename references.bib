@article{Magadi2013,
	title = {Migration as a {Risk} {Factor} for {HIV} {Infection} among {Youths} in {Sub}-{Saharan} {Africa}: {Evidence} from the {DHS}},
	volume = {648},
	issn = {0002-7162, 1552-3349},
	shorttitle = {Migration as a {Risk} {Factor} for {HIV} {Infection} among {Youths} in {Sub}-{Saharan} {Africa}},
	url = {http://journals.sagepub.com/doi/10.1177/0002716213482440},
	doi = {10.1177/0002716213482440},
	abstract = {Of the estimated 10 million youths living with HIV worldwide, 63 percent live in sub-Saharan Africa. This article focuses on migration as a risk factor of HIV infection among the youths in sub-Saharan Africa. The study is based on multilevel modeling, applied to the youth sample of the Demographic and Health Surveys (DHS), conducted from 2003 to 2008 in nineteen countries. The analysis takes into account country-level and regional-level variations. The results suggest that across countries in sub-Saharan Africa, migrants have on average about 50 percent higher odds of HIV infection than nonmigrants. The higher risk among migrants is to a large extent explained by differences in demographic and socioeconomic factors. In particular, migrants are more likely to be older, to have been married, or to live in urban areas, all of which are associated with higher risks of HIV infection. The higher risk among youths who have been married is particularly pronounced among young female migrants.},
	language = {en},
	number = {1},
	urldate = {2024-05-31},
	journal = {The ANNALS of the American Academy of Political and Social Science},
	author = {Magadi, Monica A.},
	month = jul,
	year = {2013},
	pages = {136--158},
	file = {magadi_2013_migration as a risk factor for hiv infection among youths in sub-saharan africa.pdf:files/1938/magadi_2013_migration as a risk factor for hiv infection among youths in sub-saharan africa.pdf:application/pdf},
}

