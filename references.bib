@article{Xuanming2024,
	title = {The impact of tourism development on social welfare in {Africa}: quantile regression analysis},
	volume = {27},
	issn = {1368-3500},
	shorttitle = {The impact of tourism development on social welfare in {Africa}},
	url = {https://doi.org/10.1080/13683500.2023.2214351},
	doi = {10.1080/13683500.2023.2214351},
	abstract = {The outbreak of the COVID-19 pandemic has severely affected the tourism sector which has resulted in unemployment, high rate of income inequality and poverty, and ultimately undermined social welfare improvement. Hence, to provide a better post-COVID-19 plan recovery, it’s important to promote tourism sector development which can promote inclusive growth by reducing gender inequality, income inequality and poverty. This study empirically examines the influences of tourism development on social welfare in 45 African countries during 1996–2020. The empirical evidence is based on quantile estimation techniques. The results reveal that tourism development (indicated by international tourism receipts and international tourist arrivals) appears to increase the human development index, meaning that tourism development can contribute to improving social welfare in the continent. Policy implications are discussed.},
	number = {7},
	urldate = {2024-12-02},
	journal = {Current Issues in Tourism},
	publisher = {Routledge},
	author = {Xuanming, Pan and Dossou, Toyo Amègnonna Marcel and Dossou, Kouessi Pascal and Alinsato, Alastaire Sèna},
	month = apr,
	year = {2024},
	note = {\_eprint: https://doi.org/10.1080/13683500.2023.2214351},
	keywords = {Africa, quantile regression, social welfare, Tourism development},
	pages = {1159--1172},
	file = {xuanming et al_2024_the impact of tourism development on social welfare in africa.pdf:files/4453/xuanming et al_2024_the impact of tourism development on social welfare in africa.pdf:application/pdf},
}

@article{Alam2016,
	title = {The impact of tourism on income inequality in developing economies: {Does} {Kuznets} curve hypothesis exist?},
	volume = {61},
	issn = {0160-7383},
	shorttitle = {The impact of tourism on income inequality in developing economies},
	url = {https://www.sciencedirect.com/science/article/pii/S0160738316301281},
	doi = {10.1016/j.annals.2016.09.008},
	abstract = {This paper investigates the impact of tourism on income inequality in developing economies. The analysis utilizes a balanced panel data set from 1991 to 2012 on 49 developing economies around the world. The empirical findings confirm the long-run equilibrium relationship among the variables. Results from long-run elasticities indicate that tourism increases income inequality significantly. Further, the long-run elasticities on squared tourism revenue confirm the existence of Kuznets curve hypothesis between tourism revenue and income inequalities, meaning that if the current level of tourism becomes double then it will significantly reduce the income inequality in developing economies. Given these findings, our study offers significant value to the body of knowledge on the issue of tourism and income inequality in developing economies and also provides important policy implications.},
	urldate = {2024-12-02},
	journal = {Annals of Tourism Research},
	author = {Alam, Md. Samsul and Paramati, Sudharshan Reddy},
	month = nov,
	year = {2016},
	keywords = {Developing economies, Economic growth, Income inequality, Kuznets curve hypothesis, Tourism revenue},
	pages = {111--126},
	file = {ScienceDirect Snapshot:files/4454/S0160738316301281.html:text/html},
}

@article{Ghosh2021,
	title = {Tourism and inequality: {A} relook on the {Kuznets} curve},
	volume = {83},
	issn = {0261-5177},
	shorttitle = {Tourism and inequality},
	url = {https://www.sciencedirect.com/science/article/pii/S0261517720301813},
	doi = {10.1016/j.tourman.2020.104255},
	abstract = {The study explores the impact of the tourism industry on income inequality upon a panel set of countries, classified in accordance with their levels of economic development. The countries are classified into three clusters based on their per capita GDP, the volume of international trade, and foreign direct investment inflows. The income inequality was measured using the GINI score. The long-run relationship between tourism receipts and GINI income inequality was explored for a panel set of forty-one countries over the period 1995 to 2016. The study concludes that earnings from tourism have varying impacts on the three clustered sets of countries. The inequality index of the highly developed countries remains unaffected by the earnings from tourism. The developed countries show Kuznets curve behaviour as far as the relationship between tourism and inequality is concerned. The developing countries exhibit an inverted Kuznets curve behaviour between tourism receipts and inequality of income.},
	urldate = {2024-12-02},
	journal = {Tourism Management},
	author = {Ghosh, Sudeshna and Mitra, Subrata Kumar},
	month = apr,
	year = {2021},
	keywords = {Income inequality, GINI score, Tourism income. kuznets curve},
