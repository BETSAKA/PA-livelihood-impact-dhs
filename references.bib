@book{Cooke2022,
	title = {The {Economic} {Constribution} of {Madagascar}'s {Protected} {Areas} - {A} {Review} of the {Evidence}},
	abstract = {The report seeks to assemble and review the available evidence of the global, national and local economic contributions of Madagascar’s protected areas, including non-monetary beneficial contributions, notably to human health and well-being, and to compare them with the costs of maintaining the protected areas network and the opportunity costs to households living around protected areas. We aim to evaluate the contributions that protected areas make to the world and people of Madagascar and to help Madagascar’s decision makers reach appropriate decisions on the maintenance, enhancement and financing of Madagascar’s protected areas network.},
	author = {Cooke, Andrew and Ranaivoarison, Rija and Andriamahefazafy Ramaromanana, Fano and Fenn, Mark},
