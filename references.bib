	pages = {1286--1304},
	file = {aepp.13133.pdf:files/4678/aepp.13133.pdf:application/pdf;janzen_michler_2021_ulysses' pact or span style=font-variant.pdf:files/4631/janzen_michler_2021_ulysses' pact or span style=font-variant.pdf:application/pdf},
