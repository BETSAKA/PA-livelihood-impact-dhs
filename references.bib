	pages = {e12576},
	file = {den braber et al_2018_impact of protected areas on poverty, extreme poverty, and inequality in nepal.pdf:files/3835/den braber et al_2018_impact of protected areas on poverty, extreme poverty, and inequality in nepal.pdf:application/pdf},
}

@article{Clements2014,
