$(function() {

    $('#usr_jo_mtp').on('click',function () {
        //alert("user jo");
        $('#confirm-view-acces-jo').modal('show');
    });
    $('#usr_jo_mtb').on('click',function () {
        //alert("user jo");
        $('#confirm-view-acces-jo').modal('show');
    });
    $('#btn_quit_login_jo').on('click',function () {
        //alert('close');
        $('#txt_username').val('')=="";
        $('#txt_password').val('')=="";
    })

    //----------------------------------------------------------------
    $('#sign_in_jo').submit(function(){
        var chemin_source = $('#chemin_source').val();
        var chemin=chemin_source+"page_sign_in_jo/";

        var user_name_jo=$('#txt_username').val();
        var password_jo=$('#txt_password').val();

        if(user_name_jo==''){
            $('#txt_date_reception').focus();
            swal({
                title: "<span style=\"color: #bc332a\">Veuillez saisir votre nom.<span>",
                type:"error",
                html: true
            });
        }else if(password_jo==''){
            swal({
                title: "<span style=\"color: #bc332a\">Veuillez saisir votre mot de passe.<span>",
                type: "error",
                html: true
            });
        }else{
            $.ajax(
                {
                    type:'POST',
                    url:chemin,
                    data:{jq_user_name:user_name_jo,
                        jq_password:password_jo
                    },
                    success:function(data){
                        if (data['ok']=='1')
                        {
                            var lien_jo = chemin_source + data['link_s']
                            /*swal({
                                title: "<span style=\"color: #0f8b12\">Accès autorisé<span>",
                                type:"success",
                                html: true
                            });*/
                            window.open(lien_jo, '_self');
                        }
                        else{
                            $('#txt_username').focus();
                            swal({
                                title: "<span style=\"color: #d46a55\">Accès refusé!<span>",
                                type:"error",
                                html: true
                            });
                        }
                    },
                    error:function()
                    {
                        swal({
                            title: "<span style=\"color: #bc332a\">Erreur!<span>",
                            type:"error",
                            html: true
                        });
                    }
                });
        }
        return false;

    });
    //----------------------------------------------------------------

});
